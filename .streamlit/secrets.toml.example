# Copy this file to .streamlit/secrets.toml (gitignored) and fill in real values.
# On Streamlit Community Cloud, paste the same keys into the app's "Secrets" settings panel instead.

# Shared password gate for the whole app (no per-user login in MVP).
ACCESS_CODE = "change-me"

# --- OPTIONAL: shared team key -----------------------------------------------
# If set, teammates behind the access code above get a working LLM config with
# ZERO setup - no personal Anthropic/OpenAI account needed. Each user can still
# check "Use your own API key instead" in the sidebar to override this with
# their own key. Recommended: set a hard monthly spend cap + alert on this key
# in the provider's own console (Anthropic Console / OpenAI Platform Billing) -
# THAT cap is what actually bounds your cost exposure, not which key is used.
#
# Set SHARED_PROVIDER to "anthropic" or "openai", SHARED_MODEL to one of the
# models in ALLOWED_MODELS (src/config.py) for that provider, and the matching
# key below. Leave all three commented out to require BYOK from every user
# (today's default behavior).
#
# SHARED_PROVIDER = "anthropic"
# SHARED_MODEL = "claude-sonnet-5"
# SHARED_ANTHROPIC_API_KEY = ""
# SHARED_OPENAI_API_KEY = ""

# Copy this file to .streamlit/secrets.toml (gitignored) and fill in real values.
# On Streamlit Community Cloud, paste the same keys into the app's "Secrets" settings panel instead.

# Shared password gate for the whole app (no per-user login in MVP).
ACCESS_CODE = "change-me"

# --- OPTIONAL: shared team key -----------------------------------------------
# If set, teammates behind the access code above get a working LLM config with
# ZERO setup - no personal API account needed. Each user can still check "Use
# your own API key instead" in the sidebar to override this with their own
# key. Recommended: set a hard monthly spend cap + alert on this key in the
# provider's own console (Anthropic Console / OpenAI Platform Billing /
# Google AI Studio) - THAT cap is what actually bounds your cost exposure,
# not which key is used.
#
# Set SHARED_PROVIDER to "anthropic", "openai", or "gemini"; SHARED_MODEL to
# one of the models in ALLOWED_MODELS (src/config.py) for that provider; and
# the matching key below. Leave all three commented out to require BYOK from
# every user (today's default behavior).
#
# Gemini is the cheapest of the three per-token as of July 2026 (see README
# cost comparison) and still a genuine reasoning-tier model - worth
# considering as the shared default if cost is the main adoption blocker for
# your team. Get a key at aistudio.google.com/apikey; the free tier works but
# uses your content to improve Google's products, same tradeoff as Anthropic/
# OpenAI's free tiers where they exist - use paid tier for anything with real
# project data in it.
#
# SHARED_PROVIDER = "gemini"
# SHARED_MODEL = "gemini-2.5-pro"
# SHARED_ANTHROPIC_API_KEY = ""
# SHARED_OPENAI_API_KEY = ""
# SHARED_GEMINI_API_KEY = ""
